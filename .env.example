GEMINI_API_KEY=your_google_ai_studio_key
# Also supports a project-root API-Key.txt line like: Gemini：your_google_ai_studio_key
IMAGE_PROVIDER=google-ai-studio
IMAGE_MODEL=nanobanana2
# DeepSeek is the default Agent model. Users can switch the generic Agent to
# Gemini 3.7 Flash in the page model settings when a Gemini key is configured.
AGENT_PROVIDER=deepseek
AGENT_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=your_deepseek_key
GEMINI_PERCEPTION_MODEL=gemini-3.1-flash-lite-preview

# Wuyin / Suchuang image provider
# IMAGE_PROVIDER=wuyin
# IMAGE_MODEL=gpt-image2
# WUYIN_API_KEY=your_wuyin_key
# SUCHUANG_API_KEY=your_wuyin_key
# Also supports a project-root API-Key.txt line like: shchuang：your_wuyin_key

# ModelsRouter image provider (OpenAI Images-compatible)
# Supports local reference images through /v1/images/edits image_urls.
# IMAGE_PROVIDER=modelsrouter
# IMAGE_MODEL=gpt-image-2
# MODELSROUTER_API_KEY=your_modelsrouter_key
# BRAINX_API_KEY=your_modelsrouter_key
# Also supports a project-root API-Key.txt line like: ModelsRouter：sk-...

# DeepSeek agent provider
# Also supports a project-root API-Key.txt line like: DeepSeek：sk-...

# Optional generic-harness override (A+ custom workflow still chooses its own model)
# AGENT_PROVIDER=google-ai-studio
# AGENT_MODEL=gemini-3.7-flash
